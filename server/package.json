  },
  "devDependencies": { "@types/bcrypt": "^5.0.2", "@types/cors": "^2.8.17", "@types/express": "^5.0.0", "@types/jest": "^29.5.14", "@types/jsonwebtoken": "^9.0.9", "@types/multer": "^1.4.12", "@types/node": "^22.13.4", "jest": "^29.7.0", "prisma": "^6.3.1", "supertest": "^7.0.0", "ts-jest": "^29.2.5", "tsx": "^4.19.2", "typescript": "^5.7.3" }
